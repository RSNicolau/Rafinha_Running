# ═════════════════════════════════════════════════════════════════════════════
#  RR — Rafinha Running · variáveis de ambiente (stack Docker: Caddy + Web + API + Postgres + Redis)
# ═════════════════════════════════════════════════════════════════════════════
#
#  NÃO edite este arquivo com dados reais. Ele é o "molde".
#  Para criar o seu .env com todos os segredos já gerados:
#
#      ./scripts/gerar-env.sh                 # rede local, HTTP (padrão)
#      ./scripts/gerar-env.sh --https-local   # rede local com HTTPS (PWA completo, câmera, microfone)
#      ./scripts/gerar-env.sh --vps app.seudominio.com.br
#
#  Legenda:  [OBRIGATÓRIA]  a API não sobe sem ela
#            [RECOMENDADA]  sobe sem, mas uma função importante fica desligada
#            [OPCIONAL]     só se você usa aquele recurso
#            [AUTOMÁTICA]   preenchida pelo docker-compose.yml — deixe vazia
#
#  Depois de mudar o .env:  docker compose up -d          (API/Caddy releem na hora)
#  Mudou algo marcado "(build do web)"?  docker compose up -d --build web
# ═════════════════════════════════════════════════════════════════════════════


# ─── Core ────────────────────────────────────────────────────────────────────

# [OBRIGATÓRIA] Ambiente da API. Use SEMPRE "production" (inclusive na rede local).
# Único caso para "development": testar pagamentos SIMULADOS (ver PAYMENTS_FAKE_PROVIDER).
NODE_ENV=production

# [OBRIGATÓRIA] Endereço público do sistema, exatamente como aparece no navegador (sem barra no fim).
#   Rede local:  http://192.168.0.10   (IP do Mac)      VPS:  https://app.seudominio.com.br
# Usado em links de e-mail, retornos de pagamento/OAuth, CORS e (build do web) metadados/sitemap.
APP_URL=http://localhost

# [RECOMENDADA] Mesma coisa que APP_URL (o código aceita os dois nomes). Mantenha igual ao APP_URL.
FRONTEND_URL=http://localhost

# [RECOMENDADA] Origens extras liberadas no CORS e nos WebSockets (chat/ao vivo), separadas por vírgula.
# Inclua todas as formas de acessar o sistema (ex.: IP e localhost na rede local).
ALLOWED_ORIGINS=http://localhost

# [OPCIONAL — deixe VAZIA] Base pública da API. Vazia = o sistema usa "APP_URL + /api/v1" (o correto
# neste stack, pois o Caddy entrega /api/v1 na mesma origem). ATENÇÃO: hoje o código usa esta variável
# com dois formatos diferentes (uploads espera sem /api/v1, integrações esperam com /api/v1) — por isso
# não preencha até isso ser unificado no código.
API_PUBLIC_URL=
# [OPCIONAL — legado, deixe vazia] Sinônimo antigo de API_PUBLIC_URL.
API_BASE_URL=

# [OPCIONAL] Nome exibido em e-mails. Padrão: Rafinha Running
PLATFORM_NAME=Rafinha Running
# [OPCIONAL] Esquema de deep link do app mobile (app.json → "scheme"). Padrão: rrrafinha
MOBILE_APP_SCHEME=rrrafinha
# [OPCIONAL] Documentação Swagger em /api/docs em produção (true/false). Padrão: false
ENABLE_SWAGGER=false
# [OPCIONAL] Desliga o limite de requisições (NUNCA em produção). Padrão: false
THROTTLE_DISABLED=false
# [OPCIONAL] Validade do boleto em horas. Padrão: 72
CHECKOUT_BOLETO_EXPIRATION_HOURS=72


# ─── Portaria (Caddy) ────────────────────────────────────────────────────────

# [OBRIGATÓRIA] Endereço que o Caddy atende.
#   ":80"                    → rede local, HTTP simples
#   "192.168.0.10"           → rede local com HTTPS de certificado próprio (veja docs/RODAR-LOCAL.md)
#   "app.seudominio.com.br"  → VPS, HTTPS automático (Let's Encrypt). O DNS precisa apontar para a VPS.
SITE_ADDRESS=:80
# [OPCIONAL] Vazio = automático. "tls internal" = certificado da CA local do Caddy (HTTPS na rede local).
SITE_TLS=
# [OPCIONAL] UMA opção global do Caddy. Ex.: "default_sni 192.168.0.10" (HTTPS local por IP)
# ou "email voce@seudominio.com.br" (avisos do Let's Encrypt).
CADDY_GLOBAL_OPTIONS=


# ─── Banco de dados (Postgres no próprio Docker) ─────────────────────────────

# [OBRIGATÓRIA] Credenciais do Postgres criado pelo docker-compose.
# Gere a senha só com letras/números (vai dentro de uma URL):  openssl rand -hex 24
# ATENÇÃO: o Postgres só lê estas variáveis na PRIMEIRA criação do volume. Trocar depois não muda a senha.
POSTGRES_USER=rr_user
POSTGRES_PASSWORD=
POSTGRES_DB=rr_rafinha_running

# [AUTOMÁTICA] Montadas pelo docker-compose a partir de POSTGRES_* (host "postgres").
# Só preencha para usar um banco EXTERNO (ex.: Postgres gerenciado); aí o container postgres fica ocioso.
DATABASE_URL=
DIRECT_URL=

# [AUTOMÁTICA] redis://redis:6379 (cache; sem Redis a API funciona, só sem cache)
REDIS_URL=


# ─── Segurança (todas geradas pelo scripts/gerar-env.sh) ─────────────────────

# [OBRIGATÓRIA] Assinatura dos tokens de login.   Gerar: openssl rand -base64 48
JWT_SECRET=
# [OBRIGATÓRIA] Assinatura dos refresh tokens (DIFERENTE da anterior).   Gerar: openssl rand -base64 48
JWT_REFRESH_SECRET=
# [OPCIONAL] Validade do token de acesso / refresh. Padrões: 15m / 7d
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# [OBRIGATÓRIA em produção] Criptografia AES-256-GCM dos tokens OAuth das integrações.
# Exatamente 32 bytes em hex (64 caracteres).   Gerar: openssl rand -hex 32
# NUNCA troque depois de ter usuários com integrações conectadas (os tokens ficam ilegíveis).
ENCRYPTION_KEY=
# [OBRIGATÓRIA] Criptografia de chaves BYOK de IA, segredo do 2FA e dados de pagamento. Mínimo 32 caracteres.
# Gerar: openssl rand -hex 32      (mesma regra: não trocar depois)
API_KEY_ENCRYPTION_SECRET=
# [RECOMENDADA] Assinatura dos links temporários de arquivos privados. Vazia = usa JWT_SECRET.
# Gerar: openssl rand -hex 32
FILES_SIGNING_SECRET=
# [RECOMENDADA] Assinatura dos links de onboarding. Vazia = usa JWT_SECRET.   Gerar: openssl rand -hex 32
ONBOARDING_TOKEN_SECRET=
# [RECOMENDADA] Segredo compartilhado Web(Next) → API para a API confiar no IP real do cliente
# (limite de requisições por IP). Precisa ser IGUAL nos dois (o compose já repassa).  Gerar: openssl rand -hex 32
PROXY_SHARED_SECRET=
# [OBRIGATÓRIA] Quantos proxies confiáveis existem na frente da API. Atrás do Caddy = 1.
# Se colocar Cloudflare (proxy laranja) na frente da VPS, use 2.
TRUST_PROXY_HOPS=1
# [RECOMENDADA] Token para /api/v1/metrics e /api/v1/health/detailed (header x-metrics-token).
# Gerar: openssl rand -hex 24
METRICS_TOKEN=


# ─── Pagamentos ──────────────────────────────────────────────────────────────
# Ordem de escolha do gateway pela API: PAYMENT_PROVIDER=STRIPE (se configurado) → Asaas → Stripe → Falso.

# [OPCIONAL] Força o Stripe como gateway padrão. Valores: vazio (padrão = Asaas) ou STRIPE
PAYMENT_PROVIDER=

# [OPCIONAL — só rede local] Pagamentos SIMULADOS (botão "simular pagamento").
# Só funciona com NODE_ENV=development E sem ASAAS_API_KEY/STRIPE_SECRET_KEY.
# A API se recusa a subir com isto =true se o APP_URL for um endereço público.
PAYMENTS_FAKE_PROVIDER=false

# [RECOMENDADA] Asaas (PIX, boleto, cartão — gateway principal no Brasil).
# Chave em: Asaas → Integrações → Chave de API. Sandbox: conta em sandbox.asaas.com
# ⚠ A chave do Asaas começa com "$". Coloque entre ASPAS SIMPLES, senão o Docker a apaga em silêncio:
#     ASAAS_API_KEY='$aact_...'
# (Vale para QUALQUER valor com "$" neste arquivo.)
ASAAS_API_KEY=
# Sandbox (padrão): https://api-sandbox.asaas.com/v3      Produção: https://api.asaas.com/v3
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# [OBRIGATÓRIA se usar Asaas] Token que o Asaas envia no header "asaas-access-token" do webhook.
# Você inventa (gerar: openssl rand -hex 24) e cola o MESMO valor no painel do Asaas.
# URL do webhook: https://SEU-DOMINIO/api/v1/webhooks/asaas
ASAAS_WEBHOOK_TOKEN=

# [OPCIONAL] Stripe (cartão internacional).  Webhook: https://SEU-DOMINIO/api/v1/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=

# [OPCIONAL — legado] Mercado Pago.  Webhook: https://SEU-DOMINIO/api/v1/webhooks/mercadopago
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# (nome antigo, ainda aceito como alternativa ao de cima)
MERCADOPAGO_WEBHOOK_SECRET=

# [OPCIONAL — legado] Pagar.me.  Webhook: https://SEU-DOMINIO/api/v1/payments/webhook
PAGARME_API_KEY=
PAGARME_WEBHOOK_SECRET=
# (build do web) Chave pública de criptografia de cartão do Pagar.me
NEXT_PUBLIC_PAGARME_EK=


# ─── Login social ────────────────────────────────────────────────────────────

# [OPCIONAL] Client ID OAuth do Google (login com Google)
GOOGLE_CLIENT_ID=
# [OPCIONAL] Service ID do "Sign in with Apple"
APPLE_CLIENT_ID=


# ─── Integrações de relógios/apps ────────────────────────────────────────────
# OAuth e webhooks exigem endereço PÚBLICO com HTTPS → na prática, só funcionam na VPS.

# [OPCIONAL] Strava (strava.com/settings/api). "Authorization Callback Domain" = seu domínio (sem https://)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Vazia = APP_URL/api/v1/webhooks/oauth/STRAVA/callback (recomendado deixar vazia)
STRAVA_REDIRECT_URI=
# Você inventa (openssl rand -hex 16); usado na criação da assinatura de webhook do Strava
STRAVA_WEBHOOK_VERIFY_TOKEN=
# Id devolvido pela criação da assinatura (POST /api/v1/integrations/strava/setup-webhook). Preencha depois.
STRAVA_WEBHOOK_SUBSCRIPTION_ID=
# Vazia = APP_URL/api/v1/webhooks/strava (recomendado deixar vazia)
STRAVA_WEBHOOK_CALLBACK_URL=

# ATENÇÃO (Garmin, COROS, Google Fit): se o *_REDIRECT_URI ficar vazio o código usa
# http://localhost:3000/api/integrations/<PROVEDOR>/callback, que NÃO funciona fora do seu computador.
# O gerar-env.sh preenche com a rota de callback genérica da API:
#   APP_URL/api/v1/webhooks/oauth/<PROVEDOR>/callback   (cadastre a mesma URL no painel do provedor)

# [OPCIONAL] Garmin Connect
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=
GARMIN_WEBHOOK_SECRET=

# [OPCIONAL] COROS
COROS_CLIENT_ID=
COROS_CLIENT_SECRET=
COROS_REDIRECT_URI=
COROS_WEBHOOK_SECRET=

# [OPCIONAL] Google Fit
GOOGLE_FIT_CLIENT_ID=
GOOGLE_FIT_CLIENT_SECRET=
GOOGLE_FIT_REDIRECT_URI=


# ─── E-mail e notificações ───────────────────────────────────────────────────

# [RECOMENDADA] Resend (resend.com). Sem ela, nenhum e-mail sai (recuperação de senha, convites...).
RESEND_API_KEY=
# [RECOMENDADA] Remetente — o domínio precisa estar verificado no Resend.
EMAIL_FROM=noreply@rafinharunning.com.br
# [OPCIONAL] Push no app mobile (expo.dev → Access tokens)
EXPO_ACCESS_TOKEN=


# ─── Inteligência artificial ─────────────────────────────────────────────────

# [RECOMENDADA] Anthropic (console.anthropic.com) — recursos de IA principais
ANTHROPIC_API_KEY=
# [OPCIONAL] Outros provedores usados pelo "coach brain"
OPENAI_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=


# ─── LGPD ────────────────────────────────────────────────────────────────────

# [RECOMENDADA] E-mail do encarregado (DPO) que recebe pedidos de titulares de dados
LEGAL_DPO_EMAIL=


# ─── Arquivos enviados (uploads) ─────────────────────────────────────────────

# [AUTOMÁTICA] /data/uploads dentro do container (volume "uploads" do docker-compose)
UPLOADS_DIR=
# [OPCIONAL] Supabase Storage. Se SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY estiverem preenchidas,
# os arquivos vão para o Supabase em vez do disco local.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLIC_BUCKET=athlete-uploads
SUPABASE_PRIVATE_BUCKET=athlete-private


# ─── Web (Next.js) — tudo aqui entra no build do web ─────────────────────────

# (build do web) Slug do treinador padrão na landing/loja. Padrão: rafinha
NEXT_PUBLIC_DEFAULT_COACH_ID=rafinha
# (build do web) [OPCIONAL] Google Maps (seletor de endereço e mapa de eventos)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=


# ─── Observabilidade ─────────────────────────────────────────────────────────

# [OPCIONAL] Sentry da API (projeto Node/NestJS)
SENTRY_DSN=
# [OPCIONAL] Sentry do Web — servidor (projeto Next.js). Vai como SENTRY_DSN só para o container web.
WEB_SENTRY_DSN=
# (build do web) [OPCIONAL] Sentry do Web — navegador (normalmente o mesmo DSN acima)
NEXT_PUBLIC_SENTRY_DSN=


# ─── Seeds (primeiras contas) ────────────────────────────────────────────────

# [OPCIONAL] true = roda prisma/seed.ts a cada start da API (é idempotente). Use no 1º start e volte p/ false.
SEED_ON_START=false
# [OPCIONAL] true = também roda prisma/seed-demo.ts (assessoria de demonstração com atletas fictícios)
SEED_DEMO=false
# Super admin da plataforma (acesso total). Senha mínimo 8 caracteres.
SEED_SUPER_ADMIN_EMAIL=master@rafinharunning.com
SEED_SUPER_ADMIN_PASSWORD=
# Senhas das contas fixas criadas pelo seed (coach rafinha@..., admin@..., atletas joao@/maria@email.com).
# Vazias = senha aleatória gerada e mostrada UMA vez no log da API.
SEED_COACH_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_ATHLETE_PASSWORD=
SEED_DEMO_ATHLETE_PASSWORD=


# ─── Operação (entrypoint e backup) ──────────────────────────────────────────

# [OPCIONAL] Segundos esperando o banco antes de desistir. Padrão: 90
DB_WAIT_SECONDS=90
# [OPCIONAL] true = NÃO aplica migrations no start (emergência). Padrão: false
SKIP_MIGRATIONS=false
# [OPCIONAL] Pasta dos backups (scripts/backup-db.sh) e quantos dias guardar
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
